{
  "name": "dsa-visual",
  "version": "0.1.0",
  "private": true,
  "description": "DSA Visual — o guia visual e gratuito de Algoritmos e Estruturas de Dados, feito pela comunidade Craft & Code Club.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "serve": "npx --yes serve out",
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "test:build": "next build && playwright test",
    "screenshots": "bash scripts/smoke-screenshots.sh",
    "lint": "eslint .",
    "guarda:commit": "git log --format=%s origin/main..HEAD | python3 scripts/guarda-commit.py",
    "guarda:idioma": "python3 scripts/guarda-idioma.py"
  },
  "dependencies": {
    "@mdx-js/loader": "^3.1.0",
    "@mdx-js/react": "^3.1.0",
    "@next/mdx": "16.2.12",
    "@next/third-parties": "16.2.12",
    "next": "16.2.12",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "@shikijs/rehype": "^4.4.1",
    "@types/mdx": "^2.0.13",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.2.12",
    "shiki": "^4.4.1",
    "typescript": "^5.7.0"
  }
}
